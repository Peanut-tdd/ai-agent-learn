# ===== VLM（OpenAI 兼容视觉接口）=====
VLM_MODEL=qwen-vl-max
VLM_API_KEY=
VLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 兼容别名（未设 VLM_* 时回退）
OPENAI_API_KEY=
OPENAI_BASE_URL=
VLM_TIMEOUT=30
VLM_SDK_TIMEOUT=28
VLM_MAX_CONCURRENCY=4

# ===== OCR =====
OCR_TIMEOUT=15
OCR_MAX_WORKERS=4
OCR_SERIALIZE=true

# ===== 路由阈值（一般不用改）=====
TEXT_RATIO_THRESHOLD=0.15
ENTROPY_THRESHOLD=6.5
EDGE_DENSITY_THRESHOLD=0.12
COLOR_VAR_THRESHOLD=800
OCR_THRESHOLD_CHARS=50
OCR_THRESHOLD_CONF=0.85
MIN_PROBE_CHARS_FOR_HYBRID=10

# ===== 执行 =====
MAX_RETRIES=2
RETRY_BACKOFF=0.5

# ===== 缓存：auto(先试 redis，失败降级内存) | redis | memory | none =====
CACHE_BACKEND=auto
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_SOCKET_TIMEOUT=2
CACHE_TTL=604800

# ===== 服务 =====
PDFIMG_API_KEY=
PDFIMG_HOST=0.0.0.0
PDFIMG_PORT=8000
MAX_UPLOAD_MB=16
MAX_BATCH_SIZE=32
BATCH_MAX_CONCURRENCY=8
LOG_LEVEL=INFO
