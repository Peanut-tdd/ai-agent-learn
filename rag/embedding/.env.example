# bge-m3 嵌入服务配置 (全部可选, 不设置用默认值)
# 用法: export 到环境变量 / `set -a; source .env; set +a` /
#       systemd: cp 到 ~/.config/embedding.env 由 deploy/embedding.service 读取

# --- 模型 / 推理 --------------------------------------------------------
# 模型: HF 模型名或本地目录(例如已用 huggingface-cli 下载后的路径)
EMBED_MODEL=BAAI/bge-m3

# 模型已完整缓存 / 完全离线时置 1: 启动不联网(否则即使有缓存也会去 HF 做 etag 校验,
# 直连 huggingface.co 不通时会报 httpx.ConnectTimeout / Connection refused 而启动失败)
HF_HUB_OFFLINE=1

# 需在线下载/校验时, server.py 默认已走 hf-mirror.com 镜像(国内可直连), 也可手动覆盖:
# HF_ENDPOINT=https://hf-mirror.com

# 设备: 留空=自动 (cuda > mps > cpu); 也可强制 "mps" / "cuda:0"
EMBED_DEVICE=

# 半精度推理 (mps/cuda 推荐开; cpu 上若报算子不支持则关掉)
EMBED_FP16=1

# 单次前向批大小: 内存/显存越小越调低; M1 16G 建议 8~16, 显存充足可到 64+
EMBED_INFER_BATCH=8

# 文本截断长度(token 数), bge-m3 上限 8192
EMBED_MAX_LENGTH=8192
EMBED_QUERY_MAX_LENGTH=512

# 单请求文本条数上限(服务端内部会跨请求合并攒批, 这里只是兜底防滥用)
EMBED_MAX_BATCH=128

# --- 服务端攒批 (server-side adaptive batching) ---------------------------
# 单模型并发前向无收益(并发=1)。并发小请求由服务端排队合并成一次前向,
# 调用方无需自己攒批。攒批对吞吐影响最大的两个旋钮:
# 批次内攒够多少条文本就发车(默认 4×INFER_BATCH=32; 0 = 关闭攒批, 来一批算一批)
EMBED_BATCH_TARGET=32
# 队列空了后, 最多等多少毫秒等"同路人"再单独发车(单个小请求的额外延迟 ≈ 此值)
EMBED_BATCH_GRACE_MS=4

# --- 鉴权 / 监听 ----------------------------------------------------------
# 留空 = 不鉴权(仅限内网/本机直连时)。对外开放务必设置:
# 设置后 /embed /info 需带请求头 X-API-Key(客户端 --api-key 或环境变量传入)
EMBED_API_KEY=

# 服务监听 (部署在网关后面时一般保持 0.0.0.0; 仅本机用可改 127.0.0.1)
EMBED_HOST=0.0.0.0
EMBED_PORT=8001
