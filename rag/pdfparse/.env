# ===== 缓存：auto(先试 redis，失败/未安装降级内存) | redis | memory | none =====
PDF_CACHE_BACKEND=auto
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_SOCKET_TIMEOUT=2
CACHE_TTL=604800
# 命名空间 + 版本号。版本号留空 = 自动用 pdfagent.__version__ + SCHEMA_VERSION；
# 项目更新或手工改这里都会让旧缓存失效（键格式 <ns>:<version>:<kind>:<hash>）。
PDF_CACHE_NS=rag02
PDF_CACHE_VERSION=

# ===== PDF 预检阈值（一般不用改）=====
PDF_TEXT_PAGE_MIN_CHARS=100
PDF_SPARSE_PAGE_MIN_CHARS=10
PDF_SCANNED_IMAGE_AREA_RATIO=0.5
PDF_SCANNED_RATIO_THRESHOLD=0.5
PDF_TEXT_RATIO_THRESHOLD=0.9

# ===== MinerU（混合 / 扫描型 PDF）=====
MINERU_BACKEND=auto            # auto | cli | http
MINERU_COMMAND=mineru          # 或 magic-pdf
MINERU_MODE=auto               # auto | txt | ocr
MINERU_EXTRA_ARGS=
MINERU_HTTP_URL=
MINERU_TIMEOUT=1800
MINERU_FALLBACK_TEXT=false     # MinerU 不可用时是否降级回 pymupdf
MINERU_DESCRIBE_IMAGES=false   # MinerU 路由是否再调 pdfimgpipeline 描述图

# ===== 图片语义化：curl 调用 pdfimgpipeline 服务 =====
PDFIMG_BASE_URL=http://127.0.0.1:8000
PDFIMG_API_KEY=
PDFIMG_ACTION=extract          # extract(完整) | route(仅决策)
PDFIMG_TIMEOUT=60
PDFIMG_BATCH_SIZE=16           # 单次 /extract:batch 最多张数
PDFIMG_MAX_CONCURRENCY=4       # 批量分组并发上限
PDFIMG_MAX_RETRIES=1
CURL_BIN=curl

LOG_LEVEL=INFO
